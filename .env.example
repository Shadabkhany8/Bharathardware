# ==============================================================================
# BHARAT SPONGE — B2B Wholesale Ordering Application Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (React Native / Expo)
# ------------------------------------------------------------------------------
# Default API URL pointing to Spring Boot backend:
# • Web / iOS Simulator: http://localhost:8080/api
# • Android Emulator:    http://10.0.2.2:8080/api
# • Physical Phone (LAN): http://<YOUR_COMPUTER_LAN_IP>:8080/api (e.g. http://192.168.1.15:8080/api)
EXPO_PUBLIC_API_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Java Spring Boot)
# ------------------------------------------------------------------------------
# Spring active profile: 'local' (H2 in PostgreSQL mode) or 'default' (PostgreSQL)
SPRING_PROFILES_ACTIVE=local

# Server Port
PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/bharat_sponge
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Secret & Expiration (256-bit secret key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970337336763979244226452948404D635166546A576E5A7234753778214125442A
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=*
